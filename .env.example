# Application Configuration
APP_NAME="LitePlatform App"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_BASE_PATH=
APP_KEY=change-this-to-a-random-32-plus-char-secret-key

# Architecture & Caching (Shared Hosting Tuning)
TENANCY_ENABLED=true
CACHE_DRIVER=file
PAGE_CACHE_ENABLED=false
PAGE_CACHE_TTL=300
LOG_RETENTION_DAYS=14

# Multi-Language UI (i18n)
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=vi,en
APP_LOCALE_DETECT_HEADER=true

# SEO Defaults
SEO_DESCRIPTION="Fast, lightweight PHP & MySQL web application."
SEO_LOCALE=vi_VN

# Database Configuration (mysql recommended on shared hosting, sqlite for local dev)
DB_CONNECTION=sqlite
DB_DATABASE=storage/app.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Security & Tokens
CSRF_ENABLED=true
CSRF_SECRET=change-this-csrf-secret-key-32-chars-min
JWT_SECRET=change-this-jwt-secret-key-32-chars-min
API_PROTECT_WRITES=false
TRUSTED_PROXIES=
ADMIN_SESSION_TTL=28800

# Mailer (log | smtp | http [resend/brevo]) & Telegram Lead Alerts
MAIL_DRIVER=log
MAIL_HTTP_PROVIDER=resend
MAIL_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="LitePlatform"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
