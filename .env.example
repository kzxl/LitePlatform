# Application Configuration
APP_NAME="LitePlatform App"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (sqlite, mysql, pgsql)
DB_CONNECTION=sqlite
DB_DATABASE=storage/app.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Security & Tokens
JWT_SECRET=super-secret-32-character-key-here!
CSRF_SECRET=csrf-secret-key-for-stateless-tokens
