function runTests(string $baseDir): void
{
    $phpunit = $baseDir . '/vendor/bin/phpunit';
    if (!file_exists($phpunit)) {
        echo "\033[31mError: PHPUnit not installed. Run composer install.\033[0m\n";
        exit(1);
    }

    $cmd = sprintf(
        '%s %s -c %s',
        escapeshellarg(PHP_BINARY),
        escapeshellarg($phpunit),
        escapeshellarg($baseDir . '/phpunit.xml')
    );
    passthru($cmd, $code);
    exit((int)$code);
}

function makeTest(string $baseDir, string $name): void
{
    $name = ucfirst(str_replace('Test', '', $name));
    $plural = strtolower($name) . 's';
    $testsDir = $baseDir . '/tests';
    if (!is_dir($testsDir)) {
        mkdir($testsDir, 0777, true);
    }
    $target = "{$testsDir}/{$name}ApiTest.php";

    $code = <<<PHP
<?php

declare(strict_types=1);

namespace Tests;

use Lite\Framework\Testing\TestCase;

class {$name}ApiTest extends TestCase
{
    public function testList{$name}ReturnsSuccess(): void
    {
        \$res = \$this->get('/api/{$plural}');
        \$this->assertStatus(\$res, 200);
        \$this->assertJsonOk(\$res);
    }

    public function testNonExistent{$name}Returns404(): void
    {
        \$res = \$this->get('/api/{$plural}/99999');
        \$this->assertStatus(\$res, 404);
    }
}
PHP;

    file_put_contents($target, $code);
    echo "\n\033[32m✔ Scaffolded Test:\033[0m tests/{$name}ApiTest.php\n";
    echo "Run \033[33mphp bin/lite test\033[0m to execute.\n\n";
}

function runTinker(string $baseDir): void
{
    $app = AppBootstrap::boot($baseDir);
    $container = AppBootstrap::getContainer();
    $em = $container->has(\LiteORM\EntityManager::class) ? $container->get(\LiteORM\EntityManager::class) : null;
    $db = $container->has(PDO::class) ? $container->get(PDO::class) : null;
    $audit = $container->has(\LiteAudit\AuditManager::class) ? $container->get(\LiteAudit\AuditManager::class) : null;
    $config = $container->get('config');

    echo "\n=======================================================\n";
    echo "  ⚡ LitePlatform Interactive Shell (Tinker)\n";
    echo "=======================================================\n";
    echo "  Context:\n";
    echo "    \$app       : Slim 4 Application\n";
    echo "    \$container : PHP-DI Container\n";
    echo "    \$em        : LiteORM EntityManager\n";
    echo "    \$db        : PDO Connection\n";
    echo "    \$audit     : LiteAudit AuditManager\n";
    echo "  Commands: exit, quit, clear, routes, tables\n";
    echo "=======================================================\n\n";

    $hasReadline = function_exists('readline');

    while (true) {
        if ($hasReadline) {
            $line = readline("\033[36mlite >\033[0m ");
        } else {
            echo "\033[36mlite >\033[0m ";
            $line = fgets(STDIN);
        }

        if ($line === false) break;
        $line = trim($line);
        if ($line === '') continue;
        if (in_array($line, ['exit', 'quit', 'q'], true)) break;
        if ($line === 'clear') {
            echo "\033[2J\033[;H";
            continue;
        }
        if ($line === 'tables') {
            inspectDatabase($baseDir);
            continue;
        }
        if ($line === 'routes') {
            showRoutes($baseDir);
            continue;
        }

        if ($hasReadline && function_exists('readline_add_history')) {
            readline_add_history($line);
        }

        $code = $line;
        if (!str_ends_with($code, ';') && !str_starts_with($code, 'return ') && !str_starts_with($code, 'echo ') && !str_starts_with($code, '$')) {
            $code = 'return ' . $code . ';';
        } elseif (!str_ends_with($code, ';')) {
            $code .= ';';
        }

        try {
            $result = eval($code);
            if ($result !== null) {
                if (is_object($result) || is_array($result)) {
                    echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
                } elseif (is_bool($result)) {
                    echo "\033[33m" . ($result ? 'true' : 'false') . "\033[0m\n";
                } else {
                    echo "=> " . (string)$result . "\n";
                }
            }
        } catch (\Throwable $e) {
            echo "\033[31mError: " . $e->getMessage() . "\033[0m\n";
        }
    }
    echo "\nExited Tinker.\n\n";
}

function runWatch(string $baseDir): void
{
    $cacheDir = $baseDir . '/storage/cache';
    if (!is_dir($cacheDir)) {
        mkdir($cacheDir, 0777, true);
    }
    $stampFile = $cacheDir . '/last_change.txt';

    echo "\n=======================================================\n";
    echo "  ⚡ LitePlatform Zero-Node Live Reloader\n";
    echo "=======================================================\n";
    echo "  Watching directories:\n";
    echo "    - templates/\n";
    echo "    - src/\n";
    echo "  Browser will auto-reload on file edits.\n";
    echo "  Press Ctrl+C to stop.\n";
    echo "=======================================================\n\n";

    $lastMtime = time();
    file_put_contents($stampFile, (string)$lastMtime);

    $scanMtime = function() use ($baseDir): int {
        $dirs = [$baseDir . '/templates', $baseDir . '/src'];
        $max = 0;
        foreach ($dirs as $d) {
            if (!is_dir($d)) continue;
            $iterator = new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($d));
            foreach ($iterator as $file) {
                if ($file->isFile()) {
                    $m = $file->getMTime();
                    if ($m > $max) $max = $m;
                }
            }
        }
        return $max;
    };

    while (true) {
        sleep(1);
        $currentMax = $scanMtime();
        if ($currentMax > $lastMtime) {
            $lastMtime = $currentMax;
            file_put_contents($stampFile, (string)$lastMtime);
            echo "[" . date('H:i:s') . "] \033[32mFile change detected -> Notified browser to reload.\033[0m\n";
        }
    }
}

