#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Lite\Framework\Core\AppBootstrap;
use Lite\Framework\Core\MigrationManager;
use Lite\Framework\Generators\CrudGenerator;
use LiteORM\Connection\ConnectionManager;
use LiteORM\Schema\EntityGenerator;

$baseDir = dirname(__DIR__);
$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? 'help';

switch ($command) {
    case 'status':
        showStatus($baseDir);
        break;

    case 'serve':
        $host = '127.0.0.1';
        $port = 8000;
        foreach (array_slice($argv, 2) as $arg) {
            if (str_starts_with($arg, '--host=')) {
                $host = substr($arg, 7);
            } elseif (str_starts_with($arg, '--port=')) {
                $port = (int)substr($arg, 7);
            }
        }
        echo "\n \033[36m⚡ LitePlatform Dev Server started:\033[0m http://{$host}:{$port}\n";
        echo " Press Ctrl+C to stop.\n\n";
        passthru(sprintf('php -S %s:%d -t %s', $host, $port, escapeshellarg($baseDir . '/public')));
        break;

    case 'migrate':
        runMigrations($baseDir);
        break;

    case 'migrate:sql':
        $out = $baseDir . '/dist/migrations-mysql.sql';
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--output=')) {
                $out = substr($arg, 9);
            }
        }
        $exporter = new \Lite\Framework\Console\MigrationSqlExporter();
        $res = $exporter->exportToFile($baseDir . '/database/migrations', $out);
        echo "\n\033[32m✔ Exported MySQL DDL for phpMyAdmin:\033[0m {$res['path']} (" . count($res['migrations']) . " migrations, {$res['statements']} statements)\n\n";
        break;

    case 'make:migration':
        $name = $argv[2] ?? null;
        if (!$name) {
            echo "Error: Migration name is required. Example: php bin/lite make:migration create_products_table\n";
            exit(1);
        }
        makeMigration($baseDir, $name);
        break;

    case 'db:seed':
        runSeeders($baseDir);
        break;

    case 'db:inspect':
        inspectDatabase($baseDir);
        break;

    case 'db:generate':
        $table = $argv[2] ?? null;
        generateEntitiesFromDb($baseDir, $table);
        break;

    case 'make:crud':
        $name = $argv[2] ?? null;
        if (!$name) {
            echo "Error: Entity name is required. Example: php bin/lite make:crud Product --fields=\"name:string,price:float,stock:int\"\n";
            exit(1);
        }
        $fields = '';
        foreach (array_slice($argv, 3) as $arg) {
            if (str_starts_with($arg, '--fields=')) {
                $fields = substr($arg, 9);
            }
        }
        makeCrud($baseDir, $name, $fields);
        break;

    case 'preset':
    case 'preset:web-seo':
    case 'preset:api':
    case 'preset:htmx':
    case 'preset:admin':
    case 'preset:full':
        $type = str_contains($command, ':') ? explode(':', $command)[1] : ($argv[2] ?? null);
        if (!$type) {
            echo "Error: Preset type is required. Options: web-seo, api, htmx, admin, full\n";
            exit(1);
        }
        switchPreset($baseDir, strtolower($type));
        break;

    case 'make:controller':
        $name = $argv[2] ?? null;
        if (!$name) {
            echo "Error: Controller name is required. Example: php bin/lite make:controller OrderController\n";
            exit(1);
        }
        makeController($baseDir, $name);
        break;

    case 'make:entity':
        $name = $argv[2] ?? null;
        if (!$name) {
            echo "Error: Entity name is required. Example: php bin/lite make:entity Product\n";
            exit(1);
        }
        makeEntity($baseDir, $name);
        break;

    case 'make:dto':
        $name = $argv[2] ?? null;
        if (!$name) {
            echo "Error: DTO name is required. Example: php bin/lite make:dto CreateOrderRequest\n";
            exit(1);
        }
        makeDto($baseDir, $name);
        break;

    case 'make:job':
        $name = $argv[2] ?? null;
        if (!$name) {
            echo "Error: Job name is required. Example: php bin/lite make:job SendNotificationJob\n";
            exit(1);
        }
        makeJob($baseDir, $name);
        break;

    case 'make:test':
        $name = $argv[2] ?? null;
        if (!$name) {
            echo "Error: Test name is required. Example: php bin/lite make:test Product\n";
            exit(1);
        }
        makeTest($baseDir, $name);
        break;

    case 'test':
        runTests($baseDir);
        break;

    case 'tinker':
        runTinker($baseDir);
        break;

    case 'route:cache':
        $cacheFile = AppBootstrap::compileRouteCache($baseDir);
        echo "\n\033[32m✔ Routes compiled successfully:\033[0m {$cacheFile}\n\n";
        break;

    case 'route:clear':
        AppBootstrap::clearRouteCache($baseDir);
        echo "\n\033[32m✔ Route cache cleared successfully.\033[0m\n\n";
        break;

    case 'cache:clear':
        clearAllCaches($baseDir);
        break;

    case 'build:release':
        buildSharedHostingRelease($baseDir);
        break;

    case 'watch':
        runWatch($baseDir);
        break;

    case 'routes':
        showRoutes($baseDir);
        break;

    case 'help':
    default:
        showHelp();
        break;
}

// ─── Helper Functions ──────────────────────────────────────────

function showHelp(): void
{
    echo <<<HELP

  ⚡ LitePlatform CLI Scaffolding & Developer Toolkit

  Usage:
    php bin/lite <command> [options]

  Ecosystem & Server Commands:
    status                   Inspect system health, PHP runtime, and loaded Lite* components
    serve                    Start local development server (--host=..., --port=...)
    tinker                   Interactive REPL shell with loaded ORM, DB, and Container
    watch                    Zero-Node file watcher for automatic browser live-reload
    routes                   List all registered application routes
    route:cache              Compile routes into a static cache file for 20k+ RPS
    route:clear              Clear compiled route cache
    cache:clear              Purge compiled views, route cache, and LiteCache data
    build:release            Package lightweight Shared Hosting release archive (dist/)

  Fullstack Scaffolding:
    make:crud <Name>         Scaffold entire stack: Migration, Entity, DTO, Controller & Routes
                             Option: --fields="name:string,price:float,stock:int,is_active:bool"
    make:test <Name>         Scaffold end-to-end integration test case for an Entity
    test                     Execute in-memory zero-dependency test suite

  Database & Reverse Engineering:
    db:inspect               Inspect all existing tables, column types, and row counts
    db:generate [table]      Reverse-engineer database tables into LiteORM/LiteAdmin Entity classes
    migrate                  Execute pending database migrations
    migrate:sql              Export MySQL DDL to dist/migrations-mysql.sql for phpMyAdmin (No-SSH)
    make:migration <name>    Create a new database migration file
    db:seed                  Seed the database with initial records

  Architecture Presets:
    preset:web-seo           Shared Hosting + SEO preset (ORM, Cache, View, SEO, Admin; no Tenancy)
    preset:api               Configure skeleton for REST / Microservice (< 2.5MB RAM)
    preset:htmx              Configure skeleton for SSR + HTMX Interactive Web
    preset:admin             Configure skeleton for Auto-CRUD Admin Dashboard
    preset:full              Enable all sovereign libraries

  Atomic Generators:
    make:controller <Name>   Scaffold a new PSR-15 Request/Response Controller
    make:entity <Name>       Scaffold a new LiteORM Entity with LiteAdmin attributes
    make:dto <Name>          Scaffold a new typed DTO with LiteValidate attributes
    make:job <Name>          Scaffold a new LiteQueue background Job

HELP;
}

function makeCrud(string $baseDir, string $name, string $fields): void
{
    echo "\n\033[36m⚡ Scaffolding full CRUD stack for [{$name}]...\033[0m\n";

    $generator = new CrudGenerator($baseDir);
    $files = $generator->generate($name, $fields);

    echo "  \033[32m✔ Migration  :\033[0m {$files['migration']}\n";
    echo "  \033[32m✔ Entity     :\033[0m {$files['entity']}\n";
    echo "  \033[32m✔ DTO        :\033[0m {$files['dto']}\n";
    echo "  \033[32m✔ Controller :\033[0m {$files['controller']}\n";
    echo "  \033[32m✔ Routes     :\033[0m Appended to config/routes.php\n";
    echo "  \033[32m✔ LiteAdmin  :\033[0m Registered in config/app.php\n";

    echo "\n\033[32mCRUD stack generated successfully in under 1 second!\033[0m\n";
    echo "Run \033[33mphp bin/lite migrate\033[0m to apply the database schema.\n\n";
}

function inspectDatabase(string $baseDir): void
{
    AppBootstrap::boot($baseDir);
    $container = AppBootstrap::getContainer();

    if (!$container->has(PDO::class)) {
        echo "\033[31mError: Database connection is not available.\033[0m\n";
        exit(1);
    }

    /** @var PDO $pdo */
    $pdo = $container->get(PDO::class);
    $driver = $pdo->getAttribute(PDO::ATTR_DRIVER_NAME);

    $tablesSql = match ($driver) {
        'sqlite' => "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'",
        'pgsql'  => "SELECT tablename FROM pg_tables WHERE schemaname = 'public'",
        default  => "SHOW TABLES",
    };

    $tables = $pdo->query($tablesSql)->fetchAll(PDO::FETCH_COLUMN) ?: [];

    echo "\n=======================================================\n";
    echo "  Database Schema Inspection ({$driver})\n";
    echo "=======================================================\n";

    if (empty($tables)) {
        echo "  No tables found in database.\n";
        echo "=======================================================\n\n";
        return;
    }

    foreach ($tables as $table) {
        $count = (int)$pdo->query("SELECT COUNT(*) FROM `{$table}`")->fetchColumn();
        echo sprintf("  📁 Table: \033[1;36m%-24s\033[0m (%d rows)\n", $table, $count);

        if ($driver === 'sqlite') {
            $cols = $pdo->query("PRAGMA table_info(`{$table}`)")->fetchAll(PDO::FETCH_ASSOC);
            foreach ($cols as $col) {
                $pk = $col['pk'] ? ' [PK]' : '';
                $null = $col['notnull'] ? 'NOT NULL' : 'NULL';
                echo sprintf("     - %-18s %-12s %s%s\n", $col['name'], $col['type'], $null, $pk);
            }
        }
        echo "-------------------------------------------------------\n";
    }
    echo "\n";
}

function generateEntitiesFromDb(string $baseDir, ?string $targetTable = null): void
{
    AppBootstrap::boot($baseDir);
    $container = AppBootstrap::getContainer();

    if (!$container->has(PDO::class)) {
        echo "\033[31mError: Database connection is not available.\033[0m\n";
        exit(1);
    }

    $config = $container->get('config');
    $dbConfig = $config['database'] ?? [];
    $driver = $dbConfig['default'] ?? 'sqlite';
    $connection = $dbConfig['connections'][$driver] ?? [];

    $dsn = $driver === 'sqlite'
        ? "sqlite:" . ($connection['database'] ?? ($baseDir . '/storage/app.sqlite'))
        : sprintf('mysql:host=%s;port=%s;dbname=%s;charset=%s', $connection['host'] ?? '127.0.0.1', $connection['port'] ?? 3306, $connection['database'] ?? '', $connection['charset'] ?? 'utf8mb4');

    $conn = new ConnectionManager($dsn, $connection['username'] ?? null, $connection['password'] ?? null);
    $generator = new EntityGenerator($conn, 'App\\Entities');
    $outputDir = $baseDir . '/app/Entities';

    echo "\n\033[36m⚡ Reverse-engineering database tables to Entities...\033[0m\n";

    $tables = $targetTable ? [$targetTable] : $generator->getTables();
    $generatedCount = 0;

    foreach ($tables as $tbl) {
        if ($tbl === 'migrations' || $tbl === 'audit_logs') {
            continue; // Skip internal system tables
        }

        $file = $generator->generateToFile($tbl, $outputDir);
        echo "  \033[32m✔ Generated Entity:\033[0m {$file}\n";
        $generatedCount++;
    }

    echo "\n\033[32mSuccessfully generated {$generatedCount} Entity class(es) in src/Entities/\033[0m\n\n";
}

function showStatus(string $baseDir): void
{
    $app = AppBootstrap::boot($baseDir);
    $container = AppBootstrap::getContainer();

    $libraries = [
        'LiteORM'      => class_exists(\LiteORM\EntityManager::class),
        'LiteView'     => class_exists(\LiteView\ViewEngine::class),
        'LiteAdmin'    => class_exists(\LiteAdmin\AdminDashboard::class),
        'LiteApi'      => class_exists(\LiteApi\Security\Jwt::class),
        'LiteQueue'    => class_exists(\LiteQueue\QueueManager::class),
        'LiteValidate' => class_exists(\LiteValidate\Validator::class),
        'LiteExport'   => class_exists(\LiteExport\Exporter::class),
        'LiteAudit'    => class_exists(\LiteAudit\AuditManager::class),
        'LiteInertia'  => class_exists(\LiteInertia\Inertia::class),
        'LiteUtil'     => class_exists(\LiteUtil\Number\NumberToWords::class),
    ];

    echo "\n=======================================================\n";
    echo "  ⚡ LitePlatform System & Ecosystem Status\n";
    echo "=======================================================\n";
    echo sprintf("  PHP Version    : %s\n", PHP_VERSION);
    echo sprintf("  Memory Allocated: %s MB\n", round(memory_get_usage(true) / 1024 / 1024, 2));
    echo sprintf("  Peak Memory    : %s MB\n", round(memory_get_peak_usage(true) / 1024 / 1024, 2));

    // Database check
    $dbStatus = 'Not Connected';
    if ($container->has(PDO::class)) {
        try {
            $pdo = $container->get(PDO::class);
            $dbStatus = 'Connected (' . $pdo->getAttribute(PDO::ATTR_DRIVER_NAME) . ')';
        } catch (\Throwable $e) {
            $dbStatus = 'Error: ' . $e->getMessage();
        }
    }
    echo sprintf("  Database       : %s\n", $dbStatus);
    echo "-------------------------------------------------------\n";
    echo "  Sovereign Ecosystem Components:\n";
    foreach ($libraries as $name => $loaded) {
        $status = $loaded ? "\033[32m[LOADED]\033[0m" : "\033[90m[DISABLED]\033[0m";
        echo sprintf("  %-16s : %s\n", $name, $status);
    }
    echo "=======================================================\n\n";
}

function showRoutes(string $baseDir): void
{
    $app = AppBootstrap::boot($baseDir);
    $routes = $app->getRouteCollector()->getRoutes();

    echo "\n=======================================================\n";
    echo "  Registered Routes (" . count($routes) . " total)\n";
    echo "=======================================================\n";
    foreach ($routes as $route) {
        $methods = implode('|', $route->getMethods());
        $pattern = $route->getPattern();
        $callable = $route->getCallable();
        $handler = is_array($callable) ? (is_object($callable[0]) ? get_class($callable[0]) : $callable[0]) . '::' . $callable[1] : (is_string($callable) ? $callable : 'Closure');
        echo sprintf("  [%-6s] %-30s -> %s\n", $methods, $pattern, $handler);
    }
    echo "=======================================================\n\n";
}

function runMigrations(string $baseDir): void
{
    AppBootstrap::boot($baseDir);
    $container = AppBootstrap::getContainer();

    if (!$container->has(MigrationManager::class)) {
        echo "\033[31mError: Database connection is not available.\033[0m\n";
        exit(1);
    }

    /** @var MigrationManager $migrator */
    $migrator = $container->get(MigrationManager::class);

    echo "\nRunning database migrations...\n";
    $executed = $migrator->migrate();

    if (empty($executed)) {
        echo "\033[33mNothing to migrate. Database is already up to date.\033[0m\n\n";
        return;
    }

    foreach ($executed as $mig) {
        echo "  \033[32m✔ Migrated:\033[0m {$mig}\n";
    }
    echo "\n\033[32mAll migrations completed successfully!\033[0m\n\n";
}

function makeMigration(string $baseDir, string $name): void
{
    $dir = $baseDir . '/database/migrations';
    if (!is_dir($dir)) {
        mkdir($dir, 0777, true);
    }

    $cleanName = strtolower(preg_replace('/[^a-zA-Z0-9_]/', '_', $name) ?: 'migration');
    $fileName = date('Y_m_d_His') . '_' . $cleanName . '.php';
    $filePath = $dir . '/' . $fileName;

    $template = <<<PHP
<?php

declare(strict_types=1);

/**
 * Migration: {$cleanName}
 */
return new class {
    public function up(PDO \$pdo): void
    {
        \$driver = \$pdo->getAttribute(PDO::ATTR_DRIVER_NAME);

        // Define your schema alterations here...
        // Example:
        // \$pdo->exec("CREATE TABLE IF NOT EXISTS sample (id INTEGER PRIMARY KEY);");
    }
};
PHP;

    file_put_contents($filePath, $template);
    echo "\033[32m✔ Created Migration:\033[0m database/migrations/{$fileName}\n";
}

function runSeeders(string $baseDir): void
{
    AppBootstrap::boot($baseDir);
    $container = AppBootstrap::getContainer();

    if (!$container->has(MigrationManager::class)) {
        echo "\033[31mError: Database connection is not available.\033[0m\n";
        exit(1);
    }

    /** @var MigrationManager $migrator */
    $migrator = $container->get(MigrationManager::class);

    echo "\nRunning database seeders...\n";
    $seeded = $migrator->seed();

    if (empty($seeded)) {
        echo "\033[33mNo seeders executed.\033[0m\n\n";
        return;
    }

    foreach ($seeded as $cls) {
        echo "  \033[32m✔ Seeded:\033[0m {$cls}\n";
    }
    echo "\n\033[32mDatabase seeding completed successfully!\033[0m\n\n";
}

function switchPreset(string $baseDir, string $type): void
{
    $configFile = $baseDir . '/config/app.php';
    if (!file_exists($configFile)) {
        echo "\033[31mError: config/app.php not found.\033[0m\n";
        exit(1);
    }

    $presets = [
        'web-seo' => [
            'Lite\Framework\Providers\DatabaseProvider::class, // LiteORM & PDO (MySQL)',
            'Lite\Framework\Providers\CacheProvider::class,    // LiteCache (FileOpCache + PageCache)',
            'Lite\Framework\Providers\ViewProvider::class,     // LiteView (OpCache SSR / HTMX)',
            'Lite\Framework\Providers\I18nProvider::class,     // Multi-language UI (lang/*.php)',
            'Lite\Framework\Providers\SeoProvider::class,      // Built-in SEO (Meta, JSON-LD, Sitemap, Robots, 301)',
            'Lite\Framework\Providers\CmsProvider::class,      // CMS Micro-Kit (SiteSettings, MediaManager, Blog)',
            'Lite\Framework\Providers\MailProvider::class,     // Mailer (SMTP/Resend/Brevo) & Telegram',
            'Lite\Framework\Providers\AdminProvider::class,    // LiteAdmin (Auto-CRUD Backoffice)',
        ],
        'api' => [
            'Lite\Framework\Providers\DatabaseProvider::class, // LiteORM & PDO',
            'Lite\Framework\Providers\CacheProvider::class,    // LiteCache',
            'Lite\Framework\Providers\ApiProvider::class,      // LiteApi (REST, CORS, JWT)',
        ],
        'htmx' => [
            'Lite\Framework\Providers\DatabaseProvider::class, // LiteORM & PDO',
            'Lite\Framework\Providers\CacheProvider::class,    // LiteCache',
            'Lite\Framework\Providers\ViewProvider::class,     // LiteView (SSR / HTMX)',
            'Lite\Framework\Providers\I18nProvider::class,     // Multi-language UI',
            'Lite\Framework\Providers\SeoProvider::class,      // Built-in SEO',
            'Lite\Framework\Providers\ApiProvider::class,      // LiteApi (REST, CORS, JWT)',
        ],
        'admin' => [
            'Lite\Framework\Providers\DatabaseProvider::class, // LiteORM & PDO',
            'Lite\Framework\Providers\CacheProvider::class,    // LiteCache',
            'Lite\Framework\Providers\AuditProvider::class,    // LiteAudit (Audit Trail)',
            'Lite\Framework\Providers\AdminProvider::class,    // LiteAdmin (Auto-CRUD Dashboard)',
            'Lite\Framework\Providers\ApiProvider::class,      // LiteApi (REST, CORS, JWT)',
        ],
        'full' => [
            'Lite\Framework\Providers\DatabaseProvider::class, // LiteORM & PDO',
            'Lite\Framework\Providers\CacheProvider::class,    // LiteCache (FileOpCache / DB / PageCache)',
            'Lite\Framework\Providers\ViewProvider::class,     // LiteView (SSR / HTMX)',
            'Lite\Framework\Providers\I18nProvider::class,     // Multi-language UI (lang/*.php)',
            'Lite\Framework\Providers\SeoProvider::class,      // Built-in SEO (Meta, JSON-LD, Sitemap, Robots, 301)',
            'Lite\Framework\Providers\ApiProvider::class,      // LiteApi (REST, CORS, JWT)',
            'Lite\Framework\Providers\AuditProvider::class,    // LiteAudit (Audit Trail)',
            'Lite\Framework\Providers\AdminProvider::class,    // LiteAdmin (Auto-CRUD Dashboard)',
            'Lite\Framework\Providers\QueueProvider::class,    // LiteQueue (Background Jobs)',
            'Lite\Framework\Providers\InertiaProvider::class,  // LiteInertia (React / Vue SPA)',
        ],
    ];

    if (!isset($presets[$type])) {
        echo "\033[31mUnknown preset [{$type}]. Supported presets: web-seo, api, htmx, admin, full\033[0m\n";
        exit(1);
    }

    $content = file_get_contents($configFile);
    if ($content === false) {
        echo "\033[31mError reading config/app.php\033[0m\n";
        exit(1);
    }

    $providersList = "        " . implode("\n        ", $presets[$type]);
    $newPattern = "'providers' => [\n" . $providersList . "\n    ],";

    $updated = preg_replace("/'providers'\s*=>\s*\[(.*?)\]\s*,/s", $newPattern, $content);
    if ($updated !== null) {
        if ($type === 'web-seo') {
            $updated = preg_replace(
                "/'tenancy'\s*=>\s*\[\s*'enabled'\s*=>\s*[^,\]]+,?\s*\],/s",
                "'tenancy' => [\n        'enabled' => \$envBool('TENANCY_ENABLED', false),\n    ],",
                $updated
            ) ?? $updated;
            $updated = preg_replace(
                "/'page_cache'\s*=>\s*[^,\n]+,/",
                "'page_cache' => \$envBool('PAGE_CACHE_ENABLED', true),",
                $updated
            ) ?? $updated;
        }
        file_put_contents($configFile, $updated);
        echo "\n\033[32m✔ Preset switched successfully to [{$type}]!\033[0m\n";
        echo "Active providers updated in config/app.php.\n\n";
    }
}

function clearAllCaches(string $baseDir): void
{
    $cacheDir = $baseDir . '/storage/cache';
    $removed = 0;

    if (is_dir($cacheDir)) {
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($cacheDir, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::CHILD_FIRST
        );
        foreach ($iterator as $item) {
            if ($item->isFile()) {
                @unlink($item->getPathname());
                $removed++;
            }
        }
    }

    echo "\n\033[32m✔ Cache cleared successfully ({$removed} files removed).\033[0m\n\n";
}

function buildSharedHostingRelease(string $baseDir): void
{
    $builder = new \Lite\Framework\Console\ReleaseBuilder();
    $result = $builder->build($baseDir);
    $sizeMb = round($result['bytes'] / 1024 / 1024, 2);

    echo "\n\033[32m✔ Shared Hosting release staged:\033[0m {$result['stage_dir']} ({$result['files']} files, {$sizeMb} MB)\n";
    echo "  Bundled active packages: " . implode(', ', $result['packages']) . "\n";
    echo "  Excluded: framework/Dev, framework/Testing, framework/Generators, tests/, dev vendor libs\n";
    if ($result['archive'] !== null) {
        $zipMb = round((int)filesize($result['archive']) / 1024 / 1024, 2);
        echo "\033[32m✔ Archive ready:\033[0m {$result['archive']} ({$zipMb} MB)\n";
    } else {
        echo "  (Note: ZipArchive extension not enabled locally; upload or compress dist/release/ directly.)\n";
    }
    echo "  Next: create .env on hosting (APP_ENV=production, APP_DEBUG=false, DB_CONNECTION=mysql).\n\n";
}

function makeController(string $baseDir, string $name): void
{
    $name = str_ends_with($name, 'Controller') ? $name : $name . 'Controller';
    $path = $baseDir . '/app/Controllers/' . $name . '.php';

    if (file_exists($path)) {
        echo "Error: Controller {$name} already exists.\n";
        return;
    }

    $template = <<<PHP
<?php

declare(strict_types=1);

namespace App\Controllers;

use DI\Container;
use Psr\Http\Message\ResponseInterface as Response;
use Psr\Http\Message\ServerRequestInterface as Request;

class {$name}
{
    public function __construct(private Container \$container)
    {
    }

    public function index(Request \$request, Response \$response): Response
    {
        \$data = ['message' => 'Hello from {$name}'];
        \$response->getBody()->write(json_encode(\$data));
        return \$response->withHeader('Content-Type', 'application/json');
    }
}
PHP;

    file_put_contents($path, $template);
    echo "\033[32m✔ Created Controller:\033[0m src/Controllers/{$name}.php\n";
}

function makeEntity(string $baseDir, string $name): void
{
    $name = ucfirst($name);
    $table = strtolower($name) . 's';
    $path = $baseDir . '/app/Entities/' . $name . '.php';

    if (file_exists($path)) {
        echo "Error: Entity {$name} already exists.\n";
        return;
    }

    $template = <<<PHP
<?php

declare(strict_types=1);

namespace App\Entities;

use LiteAdmin\Attribute\AdminColumn;
use LiteAdmin\Attribute\AdminField;
use LiteAdmin\Attribute\AdminResource;
use LiteORM\Attribute\AutoIncrement;
use LiteORM\Attribute\Column;
use LiteORM\Attribute\CreatedAt;
use LiteORM\Attribute\Entity;
use LiteORM\Attribute\Id;
use LiteORM\Attribute\Table;
use LiteORM\Attribute\UpdatedAt;

#[Entity]
#[Table(name: '{$table}')]
#[AdminResource(title: '{$name}s', group: 'Management')]
class {$name}
{
    #[Id]
    #[AutoIncrement]
    #[Column(type: 'integer')]
    #[AdminColumn(label: 'ID', sortable: true)]
    public ?int \$id = null;

    #[Column(type: 'string', length: 255)]
    #[AdminColumn(label: 'Name', sortable: true, searchable: true)]
    #[AdminField(label: 'Name', required: true)]
    public string \$name = '';

    #[Column(name: 'created_at', type: 'datetime')]
    #[CreatedAt]
    #[AdminColumn(label: 'Created At')]
    public ?string \$createdAt = null;

    #[Column(name: 'updated_at', type: 'datetime', nullable: true)]
    #[UpdatedAt]
    public ?string \$updatedAt = null;
}
PHP;

    file_put_contents($path, $template);
    echo "\033[32m✔ Created Entity:\033[0m src/Entities/{$name}.php\n";
}

