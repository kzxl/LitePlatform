{
    "name": "kzxl/lite-platform",
    "description": "Sovereign, High-Performance, Zero-Bloat Full-Stack PHP 8.2+ Application Skeleton.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Phong Vo",
            "email": "phong.vo@kzxl.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.14",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.0",
        "kzxl/lite-orm": "dev-main",
        "kzxl/lite-view": "dev-main",
        "kzxl/lite-admin": "dev-main",
        "kzxl/lite-api": "dev-main",
        "kzxl/lite-queue": "dev-main",
        "kzxl/lite-validate": "dev-main",
        "kzxl/lite-export": "dev-main",
        "kzxl/lite-audit": "dev-main",
        "kzxl/lite-inertia": "dev-main",
        "kzxl/lite-util": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/kzxl/LiteORM.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/kzxl/LiteQueue.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/kzxl/LiteAdmin.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/kzxl/LiteView.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/kzxl/LiteInertia.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/kzxl/LiteApi.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/kzxl/LiteValidate.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/kzxl/LiteExport.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/kzxl/LiteAudit.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/kzxl/LiteUtil.git",
            "no-api": true
        }
    ],
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {}
    }
}
