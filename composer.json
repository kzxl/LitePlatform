{
    "name": "kzxl/lite-platform",
    "description": "Sovereign, High-Performance, Zero-Bloat Full-Stack PHP 8.2+ Monorepo & Shared Hosting Framework.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Phong Vo",
            "email": "phong.vo@kzxl.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.0",
        "psr/simple-cache": "^3.0",
        "slim/slim": "^4.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Lite\\Framework\\": "framework/",
            "LiteAdmin\\": "packages/LiteAdmin/src/",
            "LiteApi\\": "packages/LiteApi/src/",
            "LiteAudit\\": "packages/LiteAudit/src/",
            "LiteCache\\": "packages/LiteCache/src/",
            "LiteExport\\": "packages/LiteExport/src/",
            "LiteInertia\\": "packages/LiteInertia/src/",
            "LiteORM\\": "packages/LiteORM/src/",
            "LiteQueue\\": "packages/LiteQueue/src/",
            "LiteSocket\\": "packages/LiteSocket/src/",
            "LiteUtil\\": "packages/LiteUtil/src/",
            "LiteValidate\\": "packages/LiteValidate/src/",
            "LiteView\\": "packages/LiteView/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "LiteAdmin\\Tests\\": "packages/LiteAdmin/tests/",
            "LiteApi\\Tests\\": "packages/LiteApi/tests/",
            "LiteAudit\\Tests\\": "packages/LiteAudit/tests/",
            "LiteCache\\Tests\\": "packages/LiteCache/tests/",
            "LiteExport\\Tests\\": "packages/LiteExport/tests/",
            "LiteInertia\\Tests\\": "packages/LiteInertia/tests/",
            "LiteORM\\Tests\\": "packages/LiteORM/tests/",
            "LiteQueue\\Tests\\": "packages/LiteQueue/tests/",
            "LiteSocket\\Tests\\": "packages/LiteSocket/tests/",
            "LiteUtil\\Tests\\": "packages/LiteUtil/tests/",
            "LiteValidate\\Tests\\": "packages/LiteValidate/tests/",
            "LiteView\\Tests\\": "packages/LiteView/tests/"
        },
        "exclude-from-classmap": [
            "packages/LiteORM/tests/Fixtures.php"
        ]
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:platform": "vendor/bin/phpunit --testsuite Platform",
        "test:packages": "vendor/bin/phpunit --testsuite LiteAdmin,LiteApi,LiteAudit,LiteCache,LiteExport,LiteInertia,LiteORM,LiteQueue,LiteSocket,LiteUtil,LiteValidate,LiteView"
    },
    "config": {
        "optimize-autoloader": true,
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {}
    }
}
