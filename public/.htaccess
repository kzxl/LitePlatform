# LitePlatform Shared Hosting Apache / LiteSpeed Rules (DocumentRoot -> public/)

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Optional: Force HTTPS + non-www in production (uncomment and set your domain)
    # RewriteCond %{HTTPS} !=on [OR]
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://example.com%{REQUEST_URI} [L,R=301]

    # Preserve Authorization header for JWT / Bearer APIs on Shared Hosting CGI/FastCGI
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block direct access to dotfiles (.env, .git, .htaccess)
    RewriteRule (^|/)\. - [F,L]

    # Route all non-file, non-directory requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Gzip compression for faster Core Web Vitals (LCP / FCP)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/javascript application/json image/svg+xml
</IfModule>

# Browser caching for immutable static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Baseline security headers at web server layer
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
